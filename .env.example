# Copiar: cp .env.example .env
#
# Profiles (elige uno):
#   COMPOSE_PROFILES=local
#   COMPOSE_PROFILES=production

COMPOSE_PROFILES=local

# local | production
DJANGO_ENV=local
DEBUG=1
# local → entrypoint.sh | production → entrypoint.prod.sh
ENTRYPOINT_SCRIPT=entrypoint.sh

SECRET_KEY=cambiar-por-una-clave-secreta-segura
DJANGO_SETTINGS_MODULE=project.settings
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TIME_ZONE=Europe/Madrid

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# Redis / Celery (contraseña obligatoria en Redis)
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@redis:6379/0
CELERY_BROKER_URL=redis://:changeme@redis:6379/0
CELERY_CONCURRENCY=2

# Sesiones (varios usuarios simultáneos)
SESSION_COOKIE_AGE=1209600

# Gunicorn (solo relevante en production)
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Admin inicial
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com
ADMIN_GROUPS=

PYTHONMALLOC=malloc
MALLOC_ARENA_MAX=2

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme
GF_USERS_ALLOW_SIGN_UP=false

# --- Producción (ejemplo) ---
# COMPOSE_PROFILES=production
# DJANGO_ENV=production
# DEBUG=0
# ENTRYPOINT_SCRIPT=entrypoint.prod.sh
# HTTP_PORT=80
# SESSION_COOKIE_SECURE=1
# CSRF_COOKIE_SECURE=1
# ALLOWED_HOSTS=tudominio.com
# CSRF_TRUSTED_ORIGINS=https://tudominio.com
